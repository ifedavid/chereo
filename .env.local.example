# Copy to .env.local and fill in from your Supabase project's Settings → API page.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public site URL (used for magic-link redirects). Set this to your deployed URL on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
